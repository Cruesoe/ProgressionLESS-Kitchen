<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- Flour and sugar recipes also need VFE Tribals agriculture when it is active -->
  <Operation Class="PatchOperationConditional">
    <success>Always</success>
    <xpath>Defs/RecipeDef[defName="DankPyon_CraftFlour"]/researchPrerequisites</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/RecipeDef[defName="DankPyon_CraftFlour"]/researchPrerequisites</xpath>
      <value>
        <li MayRequire="oskarpotocki.vfe.tribals">VFET_Agriculture</li>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/RecipeDef[defName="DankPyon_CraftFlour"]</xpath>
      <value>
        <researchPrerequisites>
          <li MayRequire="oskarpotocki.vfe.tribals">VFET_Agriculture</li>
        </researchPrerequisites>
      </value>
    </nomatch>
  </Operation>
